model Profiles {
  id      Int @id @default(autoincrement())
  user_id Int @unique

  first_name  String
  middle_name String?
  last_name   String
  phone       String
  birth_date  DateTime @db.Date
  avatar_url  String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user    Users      @relation(fields: [user_id], references: [id], onDelete: Restrict)
  address Addresses?
}
