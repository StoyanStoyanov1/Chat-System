
loki.source.file "hotel_manager" {
  targets = [
    {
      __path__ = "/var/log/hotel-manager/*.log",
      job      = "hotel-manager",
      service  = "backend",
    },
  ]

  forward_to = [loki.write.local.receiver]

  file_match {
    enabled     = true
    sync_period = "10s"
  }
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
